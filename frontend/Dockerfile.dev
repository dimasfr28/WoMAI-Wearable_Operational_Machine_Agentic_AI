# syntax=docker/dockerfile:1

# ============================================================
# Frontend (Next.js) - development image (Bun, hot-reload)
# ============================================================

FROM oven/bun:1-alpine
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1

COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

COPY . .
EXPOSE 3000
CMD ["bun", "run", "dev"]
