use_default_settings: true

general:
  instance_name: "comfest-searxng"

search:
  safe_search: 0
  autocomplete: ""
  formats:
    - html
    - json

server:
  secret_key: "comfest-searxng-secret-key-change-me"
  limiter: false
  image_proxy: false

ui:
  static_use_hash: true

outgoing:
  request_timeout: 8.0
