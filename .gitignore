# Environment / secrets
.env
.env.*
!.env.example
.txt

# Node / frontend
node_modules/
dist/
*.local

# Python / backend
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ML / model artifacts (large binaries — track intentionally if needed)
backend/saved/*.pkl
notebook/

# Data (large or host-mounted, not meant to be committed)
backend/seed_data/pdf_markdown/
*.csv

# Machine Report PDFs (generated at runtime, dev bind-mount lands them on host)
backend/reports/

# Data backup archives (scripts/backup-data.sh output) — contains real user
# accounts and uploaded documents, never meant to be committed
backups/

# Editor / OS
.vscode/
.idea/
.DS_Store

# Logs
*.log

# Docker
*.pid

# Internal planning docs / local tooling scratch — not part of the submission
docs/
firecrawl/
graphify-out/
