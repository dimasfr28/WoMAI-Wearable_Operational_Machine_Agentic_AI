FROM python:3.11-slim

# Host has no working IPv6 route AND TCP port 53 (DNS-over-TCP) is blocked on
# this network (see mineru-service/Dockerfile.dev for the full mechanism) —
# kept here too since plain pip installs can hit the same DNS path.
ENV RES_OPTIONS="no-aaaa"

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# libpango/libcairo: required at runtime by WeasyPrint (Machine Report PDF
# rendering, app/reports/report_pdf.py) — WeasyPrint shells out to Pango/Cairo
# for text layout and PDF drawing, the slim base image lacks these.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libpango-1.0-0 libpangocairo-1.0-0 libcairo2 \
    && rm -rf /var/lib/apt/lists/*

# All pinned dependencies ship manylinux wheels (scikit-learn, shap, xgboost,
# chromadb, psycopg[binary]), so build-essential/gcc is not needed and is
# skipped to keep the image lean and the build fast.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Playwright replaces the self-hosted Firecrawl stack (5 containers: api,
# playwright-service, redis, rabbitmq, nuq-postgres) for part-price scraping —
# Alibaba's search endpoint is behind Akamai Bot Manager, which fingerprints
# TLS/JA3 (not just HTTP headers), so plain requests/httpx are blocked outright;
# a real Chromium via Playwright has an identical fingerprint to a normal
# browser. `playwright install-deps` pulls the system shared libs Chromium
# dlopens at runtime (fonts, GTK, audio, etc.) that the slim base image lacks.
RUN pip install --no-cache-dir playwright==1.62.0 \
    && playwright install --with-deps chromium

# hf-xet (huggingface_hub's newer "xet-bridge" transfer protocol) hangs/stalls
# indefinitely on this network — huggingface_hub still arrives transitively via
# chromadb's tokenizers dependency even though mineru/sentence-transformers no
# longer live in this image, so this fix stays. Only *uninstalling* hf-xet
# forces the correct plain-HTTP fallback (HF_HUB_DISABLE_XET=1 does not
# actually disable it in this version).
RUN pip uninstall -y hf-xet

COPY . .

EXPOSE 8000

CMD ["bash", "-c", "alembic upgrade head && uvicorn app.main:app --host 0.0.0.0 --port 8000"]
