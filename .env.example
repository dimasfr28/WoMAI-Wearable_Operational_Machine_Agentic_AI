# Copy this file to .env and fill in real values before running ./up.sh.
# See README.md's "Environment Variables" table for details on each variable.

# --- Database (PostgreSQL) ---
POSTGRES_USER=comfest
POSTGRES_PASSWORD=changeme
POSTGRES_DB=comfest_db
DATABASE_URL=postgresql+psycopg://comfest:changeme@postgres:5432/comfest_db

# --- ChromaDB (vector store) ---
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_COLLECTION_DOCS=knowledgebase_docs
CHROMA_COLLECTION_SENSOR=knowledgebase_sensor_runs

# --- Embedding ---
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- Groq LLM (required for CRAG root-cause analysis and final report generation) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- ML model artifact paths (defaults match the volume mount in compose.yaml) ---
ML_MODEL_PATH=/app/saved/best_model.pkl
ML_PERFORMANCE_LOG_PATH=/app/saved/best_performance_log.json

# --- PDF library directory inside the backend container (defaults match the
# volume mount in compose.yaml/dev.compose.yaml/prod.compose.yaml — only
# change this if you also change those mount targets) ---
PDF_LIBRARY_DIR=/data/pdf_library

# --- SearXNG (web search fallback) ---
SEARXNG_BASE_URL=http://searxng:8080

# --- Duplicate document detection thresholds ---
DUPLICATE_CHUNK_SIMILARITY_THRESHOLD=0.93
DUPLICATE_CHUNK_RATIO_THRESHOLD=0.85

# --- JWT auth (used by both the backend and the frontend's login flow) ---
JWT_SECRET=changeme-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440
JWT_ALGORITHM=HS256

# --- Telegram notifications (optional — leave both empty to disable) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Prod only (Dokploy/Traefik routing) — unused in dev ---
BACKEND_DOMAIN=
FRONTEND_DOMAIN=
